{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
    {
      "name": "PowerServe: Server",
      "type": "PowerShell",
      "request": "launch",
      "script": "Import-Module ${workspaceFolder}/artifacts/bin/Server/debug/PowerServe.dll;Start-PowerServe;sleep 300",
      "createTemporaryIntegratedConsole": true,
      "attachDotnetDebugger": true,
      "preLaunchTask": "Build Server",
    },
    {
      "name": "Client: Hello World",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/artifacts/bin/Client/debug/PowerServeClient.dll",
      "preLaunchTask": "Build Client",
      "args": [
        "-c",
        "'Hello World'",
        "--verbose"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    }
	]
}